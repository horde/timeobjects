{
    "name": "horde/timeobjects",
    "description": "Time-based objects application",
    "type": "horde-application",
    "homepage": "https://www.horde.org",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "events",
        "weather",
        "custom_data"
    ],
    "time": "2026-07-22",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^3 || ^2",
        "php": "^8.1",
        "horde/core": "^3 || dev-FRAMEWORK_6_0",
        "horde/date": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "psr/log": "^1 || ^2 || ^3",
        "ext-gettext": "*"
    },
    "require-dev": {},
    "suggest": {
        "horde/service_facebook": "^3 || dev-FRAMEWORK_6_0",
        "horde/service_weather": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Timeobjects": "lib/"
        },
        "psr-4": {
            "Horde\\Timeobjects\\": "src/"
        }
    },
    "autoload-dev": {},
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}